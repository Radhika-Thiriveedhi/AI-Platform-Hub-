# AI Platform Hub configuration
SECRET_KEY=change-this-in-production
AI_HUB_DB_PATH=data/runtime/platform.db

# Optional hosted AI provider. Without this key the application remains usable
# with local chat and local SVG image rendering.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TEXT_MODEL=gpt-5.6-luna
OPENAI_IMAGE_MODEL=gpt-image-2
AI_USE_REMOTE=true
AI_PROVIDER_TIMEOUT=90

# Flask
TEMPLATES_AUTO_RELOAD=true
SEND_FILE_MAX_AGE=0
MAX_CONTENT_LENGTH=10485760
